# Local development only. On Replit, add GEMINI_API_KEY in Tools > Secrets.
# The app also works without a key by showing its prewritten fallback guides.

# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: change the model (check AI Studio for current names)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: force prewritten fallback guides while developing
# AI_MODE=mock
